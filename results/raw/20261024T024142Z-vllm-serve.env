# Model server launch configuration (PLAN.md M1). Fill in from NVIDIA's current Spark vLLM recipe.
# Every benchmark result references this file by hash; change it only via a new, named experiment.

# Container image — pin by digest, e.g. nvcr.io/nvidia/vllm@sha256:...
VLLM_IMAGE=vllm/vllm-openai:qwen38   # pin the digest printed by scripts/host_run_vllm.sh

MODEL=Qwen/Qwen2.5-7B-Instruct
MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
SERVED_MODEL_NAME=qwen2.5-7b-instruct

# Loopback only while developing.
HOST=172.17.0.1   # host side of the Docker bridge (see docs/host-setup.md)
PORT=8000

# Baseline settings: start from the recipe defaults and record them here explicitly.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.25  # unified memory shared with other jobs
MAX_NUM_SEQS=16
ENABLE_PREFIX_CACHING=false   # baseline off; Exp 4 turns it on

# Gateway in front of it (see gateway/config.py for all GATEWAY_* settings)
GATEWAY_UPSTREAM_URL=http://172.17.0.1:8000
GATEWAY_MAX_INFLIGHT=8         # initial guess; set from Exp 1 (concurrency knee)
GATEWAY_MAX_QUEUE=32
GATEWAY_MAX_INPUT_TOKENS=4096
GATEWAY_MAX_OUTPUT_TOKENS=1024
# Point at the model's tokenizer.json for exact input-token limits.
GATEWAY_TOKENIZER_FILE=TBD
